# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: HTTP/SOCKS5 proxy for reaching api.telegram.org, generativelanguage.googleapis.com
# (Gemini) and newsapi.org, e.g. http://user:pass@host:port or socks5://user:pass@host:port.
# Needed on hosts (e.g. some Russian VPS providers) that can't reach these APIs directly.
OUTBOUND_PROXY_URL=

# Fernet key used to encrypt/decrypt user broker tokens at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=

# SQLite database path (relative to project root)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# NewsAPI.org key used for the news sentiment feature (fetches article headlines)
NEWSAPI_KEY=

# Google Gemini API key (free tier) used to score news sentiment - get one at
# https://aistudio.google.com/apikey. This runs sentiment analysis via API call
# instead of a local model, so it needs no heavy ML runtime/RAM on this server.
GEMINI_API_KEY=
# flash-lite has a much higher free-tier daily quota than plain 2.5-flash - check yours at
# https://aistudio.google.com/rate-limit and adjust SENTIMENT_REFRESH_INTERVAL_SECONDS below
# if you track many tickers at once (one Gemini call per tracked ticker per refresh cycle).
GEMINI_MODEL=gemini-3.1-flash-lite

# Comma-separated user IDs (Telegram numeric IDs) allowed to enable real-money trading.
# Leave empty during initial setup/testing - real trading stays locked until you add yourself here.
REAL_TRADING_ALLOWLIST=

# How often (seconds) the background sentiment worker refreshes cached scores per tracked ticker
SENTIMENT_REFRESH_INTERVAL_SECONDS=1800

# Comma-separated public Telegram channel usernames (no @) scraped for posts mentioning
# a tracked ticker's company (or broad market/geopolitical news, which affects every
# tracked ticker) - fed into the same Gemini sentiment scoring as NewsAPI headlines.
# Uses the public t.me/s/<channel> preview page, so no bot admin rights or personal
# Telegram login are needed. Leave empty to disable this source.
NEWS_TELEGRAM_CHANNELS=markettwits

# Optional single-user convenience: pre-load your own T-Invest tokens from here instead of
# typing them into the bot via /start. Find your numeric Telegram ID by messaging
# @userinfobot. Get T-Invest tokens from the Т-Инвестиции app (Настройки → Токены) - start
# with the Sandbox one. Leave TINKOFF_PRODUCTION_TOKEN empty until you've validated a
# strategy in /demo. Re-applied on every restart, so editing these updates the stored token.
OWNER_TELEGRAM_ID=
TINKOFF_SANDBOX_TOKEN=
TINKOFF_PRODUCTION_TOKEN=
